{
  "schemaVersion": 1,
  "id": "astral_dice",
  "version": "${version}",
  "name": "Astral Dice",
  "description": "《星之骰戏》—— 骰子、卡牌、筹码与立牌的 Roguelike 战斗玩法。Fabric 1.21.1 移植线。",
  "authors": [
    "Merlin Kitsune"
  ],
  "contact": {},
  "license": "GPL-3.0-only (code) / CC BY-NC-SA 4.0 (assets)",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.merlinkitsune.astral_dice.AstralDiceMod"
    ],
    "client": [
      "com.merlinkitsune.astral_dice.AstralDiceClient"
    ],
    "fabric-datagen": [
      "com.merlinkitsune.astral_dice.datagen.AstralDataGenerator"
    ],
    "jade": [
      "com.merlinkitsune.astral_dice.compat.jade.AstralDiceJadePlugin"
