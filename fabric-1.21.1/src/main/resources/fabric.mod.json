    "jei_mod_plugin": [
      "com.merlinkitsune.astral_dice.compat.jei.CardShopJeiPlugin",
      "com.merlinkitsune.astral_dice.compat.jei.ChipShopJeiPlugin"
    ]
  },
  "accessWidener": "astral_dice.accesswidener",
  "mixins": [
    "astral_dice.mixins.json",
