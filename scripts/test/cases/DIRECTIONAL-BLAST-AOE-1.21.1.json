{
  "case_id": "DIRECTIONAL-BLAST-AOE-1.21.1",
  "title": "定向爆破 AOE 口径：只吃『定向爆破自身 5 点 + 效果牌伤害加成』，其它伤害效果牌不得计入",
  "version": "1.21.1",
  "target": {
    "type": "bugfix",
    "ref": "directional-blast-aoe"
  },
  "steps": [
    {
      "op": "note",
      "text": "用户 2026-09-13 裁决口径 B：AOE = 5 + 书签/忍者「效果牌伤害加成」，不含激光/板砖/轨道炮/活体书页等其它伤害牌自身加成。B1 阶段装齐其它四张伤害牌后 AOE_FORMULA 仍须为 5；B2 阶段装上书签筹码后须变为 6"
    },
    {
      "op": "inject_command",
      "command": "/astralprobe blastbonus B1"
    },
    {
      "op": "wait",
      "ms": 700
    },
    {
      "op": "inject_command",
      "command": "/astralprobe equipslot chip \"astral_dice:bookmark_chip\" B2S"
    },
    {
      "op": "wait",
      "ms": 700
    },
    {
      "op": "inject_command",
      "command": "/astralprobe blastbonus B2"
    },
    {
      "op": "wait",
      "ms": 700
    }
  ],
  "asserts": [
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B1_BONUS_BASE:0"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B1_BONUS_BLAST:0"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B1_BONUS_OTHER_CARDS:0"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B1_AOE_FORMULA:5"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B2_AOE_FORMULA:6"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B1_DONE"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B2_DONE"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B2S_EQUIP:chip:astral_dice:bookmark_chip"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_B1_ERR|AP_B1_EX|AP_B2_ERR|AP_B2_EX|AP_B2S_ERR|AP_B2S_EX|AP_TICK_EX|AP_B1_AOE_FORMULA:ERR|AP_B2_AOE_FORMULA:ERR"
    },
    {
      "type": "kubejs"
    },
    {
      "type": "crash"
    }
  ],
  "on_fail": "keep_game_running"
}
