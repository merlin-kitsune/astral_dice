    { "type": "log", "source": "latest", "pattern": "AP_Q0_QUIVER:equipped=0:tracking=0:cd=0:first=[^:]*:mark=[0-9-]+:cards=[0-9]+" },

    { "type": "log", "source": "latest", "pattern": "AP_QA_PREP:type=minecraft:spider:dist=4:seed=1:set=1:hand=astral_dice:effect_card_living_page:handn=1:" },
