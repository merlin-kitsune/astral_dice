{
  "case_id": "CHARGE-COOLDOWN-1.20.1",
  "title": "充能冷却改口径：有充能时立牌主动封顶 160 秒(3200 tick)、效果牌封顶 20 秒(400 tick)，诡异骰子先封顶后减半，且不触碰进行中的倒计时",
  "version": "1.20.1",
  "target": {
    "type": "feature",
    "ref": "charge-cooldown-cap"
  },
  "steps": [
