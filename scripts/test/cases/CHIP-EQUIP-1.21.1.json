    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B4_CHIPSTATE:.*slots=0:mods=\\[astral_dice:chip_slots=0(\\.0)?\\]:items=\\[\\]"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_E2_EQUIP:dice:astral_dice:emerald_dice"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B5_CHIPSTATE:.*slots=2:mods=\\[astral_dice:chip_slots=2(\\.0)?\\]"
    },
    {
      "type": "log",
