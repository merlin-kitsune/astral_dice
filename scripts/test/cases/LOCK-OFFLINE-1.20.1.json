      "pattern": "AP_L0S_SIGNSTATE:.*:sign=\\[\\]:lock=0:lock_end=0:grace_end=0:.*last_seen=0:.*ls_api=accessor:"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_L1P_SIGNPREP:sign=astral_dice:parunan_sign:sign_err=:stand=1:.*star=[1-9][0-9]*:.*ls_wrote=0:ls_after=0:.*:lock=0:lock_end=0:"
