    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_L1M_SIGNSTATE:mark=1:.*:sign=\\[astral_dice:parunan_sign\\]:lock=1:lock_end=[1-9][0-9]*:grace_end=0:"
