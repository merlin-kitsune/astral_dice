    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_L1N_SIGNSTATE:mark=0:lock_end_vs_mark=0:grace_end_vs_mark=0:cd_vs_mark=0:lock_sign_same=1:.*:sign=\\[astral_dice:parunan_sign\\]:lock=1:"
    },
    {
