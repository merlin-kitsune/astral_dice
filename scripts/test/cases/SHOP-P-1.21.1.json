    {
      "op": "inject_command",
      "command": "/astralshop reset O",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 1200
    },
    {
      "op": "inject_command",
      "command": "/astralshop bal O 790",
      "no_esc": true
