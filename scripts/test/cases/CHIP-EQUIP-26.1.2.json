      "pattern": "AP_B3_CHIPSTATE:.*slots=1:.*mods=\\[astral_dice:chip_slots=1(\\.0)?\\]:items=\\[0:astral_dice:flashlight_chipx1\\]"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B4_CHIPSTATE:.*slots=0:.*mods=\\[astral_dice:chip_slots=0(\\.0)?\\]:items=\\[\\]"
    },
    {
      "type": "log",
