      "pattern": "APDUMP\\|LOCKRAW\\|"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_M5_STATE:.*:chipSlots=(\\d+):chipCosmetic=\\1"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_M[0-9]_ERR|AP_M[0-9]_EX|AP_OP_EX|AP_M2_ITEMCOUNT:astral_dice=(0|-1)|threw an exception"
    },
