{
  "case_id": "MIGRATION-SMOKE-26.1.2",
  "title": "26.1.2 迁移冒烟：探针基础设施 / 123 物品注册 / 附件可读 / Curios 槽位与骰子装配 / dump 机器行 / OP 判据同源",
  "version": "26.1.2",
  "target": {
    "type": "existing-feature",
    "ref": "mc-26.1.2-migration"
  },
  "steps": [
    {
      "op": "note",
      "text": "第一轮(2026-09-16)通过；2026-09-17 第二轮前已把 run 侧探针换成**完整迁移版**(astral_bugfix_probe.js,1.21.1 → 26.1.2),本条目的 M1 断言随之改为锚定完整探针 doDiag 的关键读数(levelClass / scheduler / dmgMessage),M2~M6 仍用迁移期附加命令(itemcount/give/equipslot/readstate)与原有 dumpstate。"
    },
    {
      "op": "inject_command",
      "command": "/astralprobe diag M1"
    },
    {
      "op": "wait",
      "ms": 1500
    },
    {
      "op": "inject_command",
      "command": "/astralprobe itemcount M2"
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "inject_command",
      "command": "/astralprobe give \"astral_dice:dice\" 1 M3"
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "inject_command",
      "command": "/astralprobe equipslot dice \"astral_dice:dice\" M4"
    },
    {
      "op": "wait",
      "ms": 1200
    },
    {
      "op": "inject_command",
      "command": "/astralprobe readstate M5"
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "inject_command",
      "command": "/astralprobe dumpstate M6"
    },
    {
      "op": "wait",
      "ms": 1200
    }
  ],
  "asserts": [
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_M1_DIAG:levelClass=net\\.minecraft\\.server\\.level\\.ServerLevel"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_M1_DIAG:scheduler=ok"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_M1_DIAG:dmgMessage=ok"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_M1_DONE"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_M2_ITEMCOUNT:astral_dice=123"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_M3_GIVE:astral_dice:dice:1"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_M4_EQUIP:dice:astral_dice:dice"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_M5_STATE:healing=-?\\d+:pages=-?\\d+"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_M5_STATE:.*:dice=1:diceSlots=\\d+"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "APDUMP\\|LOCKRAW\\|"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_M5_STATE:.*:chipSlots=(\\d+):chipCosmetic=\\1"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_M[0-9]_ERR|AP_M[0-9]_EX|AP_OP_EX|AP_M2_ITEMCOUNT:astral_dice=(0|-1)|threw an exception"
    },
    {
      "type": "kubejs"
    },
    {
      "type": "crash"
    }
  ],
  "on_fail": "keep_game_running"
}
