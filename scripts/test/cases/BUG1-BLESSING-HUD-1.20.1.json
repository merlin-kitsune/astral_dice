{
  "case_id": "BUG1-BLESSING-HUD-1.20.1",
  "title": "bug1 骰神赐福应触发 + 伤害跳字 HUD 应显示",
  "version": "1.20.1",
  "target": {
    "type": "bugfix",
    "ref": "bug1"
  },
  "steps": [
    {
      "op": "note",
      "text": "步骤1 清空残留赐福/赋能,保证本次为全新触发"
    },
    {
      "op": "inject_command",
      "command": "/astralprobe blessingclear B1"
    },
    {
      "op": "inject_command",
      "command": "/astralprobe empowerclear B1"
    },
    {
      "op": "note",
      "text": "步骤2 骰子装入 dice 槽 + 主手持剑(赐福的两个前置条件)"
    },
    {
      "op": "inject_command",
      "command": "/astralprobe setup \"astral_dice:dice\" \"minecraft:diamond_sword\" B1"
    },
    {
      "op": "wait",
      "ms": 700
    },
    {
      "op": "note",
      "text": "步骤3 以「玩家攻击」伤害源命中正前方 3 格处的僵尸(等价真实近战),随后读状态确认赐福已挂上"
    },
    {
      "op": "inject_command",
      "command": "/astralprobe attack \"minecraft:zombie\" B1"
    },
    {
      "op": "wait",
      "ms": 900
    },
    {
      "op": "inject_command",
      "command": "/astralprobe status B1"
    },
    {
      "op": "wait",
      "ms": 400
    },
    {
      "op": "note",
      "text": "步骤4 HUD 隔离验证:绕过骰战链直发伤害跳字包,持续 6 秒供截图取证(把「HUD 覆层不渲染」与「赐福链不触发」两个症状分开定位)"
    },
    {
      "op": "inject_command",
      "command": "/astralprobe hud 120 B1H"
    },
    {
      "op": "wait",
      "ms": 1600
    },
    {
      "op": "screenshot",
      "tag": "bug1_hud",
      "mode": "f2"
    },
    {
      "op": "wait",
      "ms": 400
    }
  ],
  "asserts": [
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B1_SETUP:astral_dice:dice:minecraft:diamond_sword"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B1_DICE:astral_dice:dice"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B1_MAINHAND:minecraft:diamond_sword"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B1_BLESSING:1:\\d+:1\\d{3}"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B1H_HUD:\\d+:120:1"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_B1_ERR|AP_B1_EX|AP_B1H_ERR|AP_B1H_EX|AP_B1H_HUD_ABORT|AP_TICK_EX"
    },
    {
      "type": "vision",
      "question": "画面中是否出现橙红色浮动伤害数字(跳字 HUD,数值 777)?",
      "image": "bug1_hud"
    },
    {
      "type": "kubejs"
    },
    {
      "type": "crash"
    }
  ],
  "on_fail": "keep_game_running"
}
