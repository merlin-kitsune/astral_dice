{
  "case_id": "BUG5-RAILGUN-DELAY-CD-1.21.1",
  "title": "bug5 电磁炮雷击应延迟 1 秒并进入 1:00 冷却",
  "version": "1.21.1",
  "target": {
    "type": "bugfix",
    "ref": "bug5"
  },
  "steps": [
    {
      "op": "note",
      "text": "步骤1 先开观测窗口(200 tick,见到新增雷击即定论),再自测:清冷却 → 充能恰好 6 层 → 装电磁炮筹码 → 攻击僵尸,并在同一 tick 内立刻采样"
    },
    {
      "op": "inject_command",
      "command": "/astralprobe watch 200 B5W"
    },
    {
      "op": "inject_command",
      "command": "/astralprobe railtest B5"
    },
    {
      "op": "wait",
      "ms": 500
    },
    {
      "op": "note",
      "text": "步骤2 等待延迟到期(1 秒)与冷却计时启动"
    },
    {
      "op": "wait",
      "ms": 1400
    },
    {
      "op": "inject_command",
      "command": "/astralprobe status B5L"
    },
    {
      "op": "wait",
      "ms": 400
    }
  ],
  "asserts": [
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B5_CHIP:ok"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B5_DELAY:20"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B5_LIGHTNING_NOW:0"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B5_CD_AFTER:1200"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B5_CHARGE_AFTER:0"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B5W_LIGHTNING_MAX:[1-9]"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_B5L_RAILGUN_CD:1[01]\\d\\d"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_B5_ERR|AP_B5_EX|AP_B5L_ERR|AP_B5L_EX|AP_B5W_WATCH_TIMEOUT|AP_TICK_EX"
    },
    {
      "type": "kubejs"
    },
    {
      "type": "crash"
    }
  ],
  "on_fail": "keep_game_running"
}
