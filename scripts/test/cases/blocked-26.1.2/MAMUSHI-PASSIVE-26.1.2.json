    { "op": "wait", "ms": 700 },
    { "op": "inject_command", "command": "/player Bot3 kill", "no_esc": true },
    { "op": "wait", "ms": 700 },
    { "op": "inject_command", "command": "/player Bot1 spawn at ~3 ~ ~1", "no_esc": true },
    { "op": "wait", "ms": 1800 },
    { "op": "inject_command", "command": "/player Bot2 spawn at ~-3 ~ ~1", "no_esc": true },
    { "op": "wait", "ms": 1800 },
    { "op": "inject_command", "command": "/player Bot3 spawn at ~ ~ ~3", "no_esc": true },
    { "op": "wait", "ms": 1800 },
    { "op": "inject_command", "command": "/clear Bot1", "no_esc": true },
    { "op": "wait", "ms": 500 },
    { "op": "inject_command", "command": "/clear Bot2", "no_esc": true },
    { "op": "wait", "ms": 500 },
    { "op": "inject_command", "command": "/clear Bot3", "no_esc": true },
    { "op": "wait", "ms": 500 },
    { "op": "inject_command", "command": "/team leave Bot1", "no_esc": true },
    { "op": "wait", "ms": 400 },
    { "op": "inject_command", "command": "/team leave Bot2", "no_esc": true },
    { "op": "wait", "ms": 400 },
    { "op": "inject_command", "command": "/team leave Bot3", "no_esc": true },
