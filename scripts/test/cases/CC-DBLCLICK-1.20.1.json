      "pattern": "AP_CC2C:t=\\d+:phase=after_dbl2:.*:c0=astral_dice:attack_card_mediumx1:c1=astral_dice:attack_card_mediumx1:c2=empty:.*:s30=astral_dice:attack_card_mediumx2"
    },
    {
      "type": "log",
