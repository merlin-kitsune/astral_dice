      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 600
    },
    {
      "op": "inject_command",
      "command": "/astralshop creset G5",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 600
    },
    {
      "op": "inject_command",
      "command": "/astralfixbatch card3 G5",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 600
    },
    {
