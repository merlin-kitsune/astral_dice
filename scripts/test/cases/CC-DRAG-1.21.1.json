{
  "case_id": "CC-DRAG-1.21.1",
  "title": "选卡界面 §9-2：拖动 ≥4px 升格跟手；松手空卡槽=放入；卡槽拖回物品栏空格=落格；松手空白处=原路还原",
  "version": "1.21.1",
  "target": {
    "type": "feature",
    "ref": "card-choice-screen"
  },
  "steps": [
    {
      "op": "note",
      "text": "选卡界面实机（spec §9）。界面本批未接任何技能 ⇒ 由临时探针 /astralcc open 按产品公开 API CardChoiceManager.start 打开；卡牌移动走客户端屏幕事件 → 原版点击包 → 服务端菜单的真实链路。"
    },
    {
      "op": "inject_command",
      "command": "/gamemode creative",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 600
    },
    {
      "op": "inject_command",
      "command": "/clear @s",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 600
    },
    {
      "op": "inject_command",
      "command": "/item replace entity @s hotbar.0 with astral_dice:attack_card_medium 1",
      "no_esc": true
    },
    {
      "op": "inject_command",
      "command": "/item replace entity @s hotbar.1 with astral_dice:attack_card_large 1",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "inject_command",
      "command": "/astralcc open 3 combat drag",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 8000
    }
  ],
  "asserts": [
    {
      "type": "mixin"
    },
    {
      "type": "kubejs"
    },
    {
      "type": "crash"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "step=70:phase=after_drag_back:.*:c0=empty:c1=empty:c2=empty:carried=empty:inv=\\{1:astral_dice:attack_card_largex1,2:astral_dice:attack_card_mediumx1\\}"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "step=96:phase=after_blank_drop:.*:c0=empty:c1=empty:c2=empty:carried=empty:inv=\\{1:astral_dice:attack_card_largex1,2:astral_dice:attack_card_mediumx1\\}"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_CC:OPEN:token=\\d+:ok=1:slots=3:type=combat:seq=drag:has_session=1"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "step=44:phase=after_drag_in:.*:c0=astral_dice:attack_card_medium:c1=empty"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "SCREEN:closed"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_CARD_CHOICE: abandon:\\d+:player=.*:consumed=0"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_CARD_CHOICE: confirm:"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_CC:(OPEN_EX|OPEN_ERR|HANDLER_ERR|STATE_ERR|CDSET_ERR|DIAG_ERR|SAMPLE_ERR|CDS_ERR)"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_CCC:RUN_EX:"
    }
  ]
}
