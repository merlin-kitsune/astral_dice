    { "op": "inject_command", "command": "/astralprobe terudummy T2 d2 \"minecraft:spider\" 6 1000", "no_esc": true },
    { "op": "wait", "ms": 900 },

    { "op": "note", "text": "主判据相位：base=200、层数 5、已在骰神赐福（骰战链的进入前提之一）⇒ 第 1 次命中 d1 必须 −1 层且掉血 >100。" },
    { "op": "inject_command", "command": "/astralprobe terulink LK 0 0 200 0 1 5 -", "no_esc": true },
    { "op": "wait", "ms": 1200 },
