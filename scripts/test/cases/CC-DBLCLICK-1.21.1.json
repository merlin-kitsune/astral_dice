{
  "case_id": "CC-DBLCLICK-1.21.1",
  "title": "选卡界面 §9-1：双击物品栏战斗牌放入卡槽 1/3；再次双击卡槽取回物品栏",
  "version": "1.21.1",
  "target": {
    "type": "feature",
    "ref": "card-choice-screen"
  },
  "steps": [
    {
      "op": "note",
      "text": "选卡界面实机（spec §9）。界面本批未接任何技能 ⇒ 由临时探针 /astralcc open 按产品公开 API CardChoiceManager.start 打开；卡牌移动走客户端屏幕事件 → 原版点击包 → 服务端菜单的真实链路。"
    },
    {
      "op": "inject_command",
      "command": "/gamemode creative",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 600
    },
    {
      "op": "inject_command",
      "command": "/clear @s",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 600
    },
    {
      "op": "inject_command",
      "command": "/item replace entity @s hotbar.0 with astral_dice:attack_card_medium 1",
      "no_esc": true
    },
    {
      "op": "inject_command",
      "command": "/item replace entity @s hotbar.1 with astral_dice:attack_card_large 1",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "inject_command",
      "command": "/astralcc open 3 combat dblclick",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 6000
    }
  ],
  "asserts": [
    {
      "type": "mixin"
    },
    {
      "type": "kubejs"
    },
    {
      "type": "crash"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "AP_CC:OPEN:token=\\d+:ok=1:slots=3:type=combat:seq=dblclick:has_session=1"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "SCREEN:open:token=\\d+:n=\\d+:seq=dblclick"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "step=42:phase=after_dbl_in:.*:complete=0:filled=1:c0=astral_dice:attack_card_medium:c1=empty:c2=empty:carried=empty"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "step=70:phase=after_dbl_back:.*:c0=empty:c1=empty:c2=empty:carried=empty:inv=\\{[^}]*8:astral_dice:attack_card_mediumx1"
    },
    {
      "type": "log",
      "source": "latest",
      "pattern": "SCREEN:closed"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_CARD_CHOICE: confirm:"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_CARD_CHOICE: reject:"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_CC:(OPEN_EX|OPEN_ERR|HANDLER_ERR|STATE_ERR|CDSET_ERR|DIAG_ERR|SAMPLE_ERR|CDS_ERR)"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_CCC:RUN_EX:"
    }
  ]
}
