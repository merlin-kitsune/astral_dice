    {
      "op": "wait",
      "ms": 250
    },
    {
      "op": "inject_command",
      "command": "/astralshop reset O",
      "no_esc": true
    },
    {
      "op": "wait",
      "ms": 1200
    },
    {
      "op": "inject_command",
      "command": "/astralshop star O 6",
