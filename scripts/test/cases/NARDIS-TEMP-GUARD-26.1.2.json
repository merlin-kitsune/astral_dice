      "pattern": "AP_[A-Z0-9]+_ERR"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "AP_[A-Z0-9]+_EX:"
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": ":err="
    },
    {
      "type": "absent",
      "source": "latest",
      "pattern": "Unknown or incomplete command"
    },
    {
      "type": "kubejs"
    },
    {
      "type": "crash"
    }
  ],
  "evidence": []
}
